APP_ENV=production
LOG_LEVEL=INFO

LCD_ENABLED=true
LCD_I2C_BUS=1
LCD_I2C_ADDRESS=0x27
LCD_COLUMNS=16
LCD_ROWS=2

LIMIT_SWITCH_GPIO=5
LIMIT_SWITCH_BOUNCE_TIME=0.05
LIMIT_SWITCH_ACTIVE_LOW=true

SERVO_MOVE_TO_STRIKE_TIME=0.30
SERVO_STRIKE_HOLD_TIME=0.06
SERVO_RETURN_HOME_TIME=0.30
SERVO_HOME_SETTLE_TIME=0.18
# true: về HOME, chờ đủ return + settle rồi detach để dừng hunting/buzz.
# Cơ cấu phải có điểm tựa/lò xo/đối trọng nếu thanh bị nghiêng khi mất torque.

CAMERA_DEVICE_INDEX=0
# Camera USB: để trống hoặc nhập /dev/video0.
# Camera điện thoại: nhập URL HTTP/HTTPS/RTSP, ví dụ http://192.168.1.50:8080/video.
CAMERA_DEVICE_PATH=
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
# Để trống các control hình ảnh để giữ nguyên giá trị gốc của camera.
CAMERA_FOURCC=MJPG
CAMERA_FPS=30
CAMERA_BRIGHTNESS=
CAMERA_CONTRAST=
CAMERA_SATURATION=
CAMERA_GAMMA=
CAMERA_SHARPNESS=
CAMERA_BACKLIGHT_COMPENSATION=
# Chỉ khử nhấp nháy điện 50 Hz; không thay đổi màu.
CAMERA_POWER_LINE_FREQUENCY=1
CAMERA_AUTO_WHITE_BALANCE=true
CAMERA_WHITE_BALANCE_TEMPERATURE=
# Không bù kênh màu, saturation hay histogram bằng phần mềm.
CAMERA_RED_GAIN=1.0
CAMERA_GREEN_GAIN=1.0
CAMERA_BLUE_GAIN=1.0
CAMERA_COLOR_SATURATION_SCALE=1.0
CAMERA_HISTOGRAM_EQUALIZATION=false
CAMERA_CLAHE_CLIP_LIMIT=1.5
CAMERA_CLAHE_GRID_SIZE=8
CAMERA_WARMUP_SECONDS=3.0
CAMERA_LOCK_WHITE_BALANCE=true
CAMERA_LOCK_EXPOSURE=true
CAMERA_WARMUP_FRAMES=5
CAMERA_RETRY_COUNT=2
CAMERA_PREVIEW_ENABLED=true
CAMERA_PREVIEW_HOST=0.0.0.0
CAMERA_PREVIEW_PORT=8081
CAMERA_PREVIEW_FPS=3
CAMERA_PREVIEW_JPEG_QUALITY=90
CAMERA_CAPTURE_JPEG_QUALITY=100
CAMERA_FOCUS_SAMPLE_FRAMES=15
CAMERA_BLUR_THRESHOLD=28.0
CAMERA_ROI_PATH=config/camera_roi.json
CAPTURE_OUTPUT_DIR=captures

MODEL_PATH=../model/onnx/mobilenetv1_image.onnx
IMAGE_MODEL_PYTHON=.venv/bin/python
MODEL_CLASSES_PATH=config/classes.txt
MODEL_INPUT_WIDTH=224
MODEL_INPUT_HEIGHT=224
MODEL_NORMALIZATION=minus_one_one
MODEL_OUTPUT_TYPE=softmax
MODEL_CONFIDENCE_THRESHOLD=0.5

AUDIO_MODEL_PATH=../model/model-audio.pt
AUDIO_MODEL_PYTHON=.venv/bin/python
AUDIO_MODEL_CONFIDENCE_THRESHOLD=0.0
AUDIO_RECORD_SECONDS=5.0
CAPTURE_IMAGES_PER_JOB=3
CAPTURE_IMAGE_INTERVAL_SECONDS=3.0
FUSION_IMAGE_WEIGHT=0.6
FUSION_AUDIO_WEIGHT=0.4
# Bật sau khi đã chụp và lưu ảnh khay trống tại đường dẫn bên dưới.
DURIAN_PRESENCE_ENABLED=false
EMPTY_SCENE_REFERENCE_PATH=config/empty_scene.jpg
DURIAN_PRESENCE_DIFFERENCE_THRESHOLD=6.0

RESULT_DISPLAY_SECONDS=15
ERROR_DISPLAY_SECONDS=2
DELETE_IMAGE_AFTER_INFERENCE=false

HARDWARE_MOCK=false
MOCK_IMAGE_PATH=
